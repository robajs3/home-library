# Domyślnie puste - aplikacja odpowiada pod "/". Ustaw APP_PREFIX=/homelibrary
# TYLKO jeśli wystawiasz appkę bez ucinania prefiksu przez proxy (np. dzielisz
# port z inną usługą bez rewrite). Przy `tailscale serve --set-path=/homelibrary`
# zostaw puste - Tailscale sam ucina prefiks przed przekazaniem żądania.
APP_PREFIX=
